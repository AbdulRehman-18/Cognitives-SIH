# ── Database (Neon Postgres + pgvector) ──────────────────────────────────────
# Neon connection string. Must point at a database where `CREATE EXTENSION vector`
# can be run (enabled by default on all Neon plans).
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/skillforge?sslmode=verify-full"

# ── Auth.js v5 ────────────────────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# ── AI provider selection ─────────────────────────────────────────────────────
# "openrouter" (default, generation via google/gemini-3.7-flash with failover)
# or "gemini" (direct @google/genai). Embeddings ALWAYS go direct to Gemini
# regardless of this setting (OpenRouter serves no embedding models).
AI_PROVIDER="openrouter"

# OpenRouter — generation (google/gemini-3.7-flash primary, with models[] failover)
OPENROUTER_API_KEY=""

# Gemini — direct generation (when AI_PROVIDER=gemini) AND always used for
# embeddings (gemini-embedding-001, outputDimensionality=1536, L2-normalized).
GEMINI_API_KEY=""

# ── File storage (UploadThing) ────────────────────────────────────────────────
# Originals (uploaded documents) never live in the relational DB — only
# UploadThing keys/URLs are persisted on the Document row.
UPLOADTHING_TOKEN=""

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── iGOT Karmayogi integration (src/lib/igot) ─────────────────────────────────
# "mock" (default) serves the real iGOT course rows from prisma/course-catalog.ts
# and simulates enrolment progress; "live" calls the Sunbird-based iGOT APIs
# (requires Karmayogi Bharat partner onboarding).
IGOT_MODE=mock
IGOT_API_BASE=
IGOT_API_KEY=
# Optional: user-scoped token for enrol/progress calls, and portal base for deep links.
IGOT_USER_TOKEN=
IGOT_PORTAL_URL=https://portal.igotkarmayogi.gov.in/

# Vercel Cron authenticates the nightly iGOT progress sync with this bearer secret.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Single sign-on (src/lib/auth/sso.ts) — each provider is enabled only when set ─
# Government OpenID Connect IdP (e.g. Jan Parichay / NIC SSO).
GOV_SSO_ISSUER=
GOV_SSO_CLIENT_ID=
GOV_SSO_CLIENT_SECRET=
GOV_SSO_NAME=Jan Parichay
# Google (demo SSO). Callback URL: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
