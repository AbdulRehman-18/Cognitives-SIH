# ── Database (Neon Postgres + pgvector) ──────────────────────────────────────
# Neon connection string. Must point at a database where `CREATE EXTENSION vector`
# can be run (enabled by default on all Neon plans).
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/skillforge?sslmode=require"

# ── Auth.js v5 ────────────────────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# ── AI provider selection ─────────────────────────────────────────────────────
# "openrouter" (default, generation via google/gemini-3.7-flash with failover)
# or "gemini" (direct @google/genai). Embeddings ALWAYS go direct to Gemini
# regardless of this setting (OpenRouter serves no embedding models).
AI_PROVIDER="openrouter"

# OpenRouter — generation (google/gemini-3.7-flash primary, with models[] failover)
OPENROUTER_API_KEY=""

# Gemini — direct generation (when AI_PROVIDER=gemini) AND always used for
# embeddings (gemini-embedding-001, outputDimensionality=1536, L2-normalized).
GEMINI_API_KEY=""

# ── File storage (UploadThing) ────────────────────────────────────────────────
# Originals (uploaded documents) never live in the relational DB — only
# UploadThing keys/URLs are persisted on the Document row.
UPLOADTHING_TOKEN=""

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
